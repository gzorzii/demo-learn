n\", Component: Calibration },\n      { path: \"history\", Component: History },\n      { path: \"faq\", Component: FAQ },\n    ],\n  },\n]);","fullPath":"src/app/routes.tsx","isBinary":false,"lastModified":1778034391175},"tsconfig.node.json":{"name":"tsconfig.node.json","type":"file","contents":"{\n  \"compilerOptions\": {\n    \"tsBuildInfoFile\": \"./node_modules/.tmp/tsconfig.node.tsbuildinfo\",\n    \"target\": \"es2023\",\n    \"lib\": [\"ES2023\"],\n    \"module\": \"esnext\",\n    \"types\": [\"node\"],\n    \"skipLibCheck\": true,\n\n    /* Bundler mode */\n    \"moduleResolution\": \"bundler\",\n    \"allowImportingTsExtensions\": true,\n    \"verbatimModuleSyntax\": true,\n    \"moduleDetection\": \"force\",\n    \"noEmit\": true,\n\n    /* Linting */\n    \"noUnusedLocals\": true,\n    \"noUnusedParameters\": true,\n    \"erasableSyntaxOnly\": true,\n    \"noFallthroughCasesInSwitch\": true\n  },\n  \"include\": [\"vite.config.ts\"]\n}\n","fullPath":"tsconfig.node.json","isBinary":false,"lastModified":1778026433256},"pnpm-workspace.yaml":{"name":"pnpm-workspace.yaml","type":"file","contents":"packages:\n  - '.'","fullPath":"pnpm-workspace.yaml","isBinary":false,"lastModified":1778026433256},"src/assets/hero.png":{"name":"hero.png","type":"file","contents":"","fullPath":"src/assets/hero.png","isBinary":true,"lastModified":1778026433256},"src/assets/vite.svg":{"name":"vite.svg","type":"file","contents":"\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"77\" height=\"47\" fill=\"none\" aria-labelledby=\"vite-logo-title\" viewBox=\"0 0 77 47\"\u003e\u003ctitle id=\"vite-logo-title\"\u003eVite\u003c/title\u003e\u003cstyle\u003e.parenthesis{fill:#000}@media (prefers-color-scheme:dark){.parenthesis{fill:#fff}}\u003c/style\u003e\u003cpath fill=\"#9135ff\" d=\"M40.151 45.71c-.663.844-2.02.374-2.02-.699V34.708a2.26 2.26 0 0 0-2.262-2.262H24.493c-.92 0-1.457-1.04-.92-1.788l7.479-10.471c1.07-1.498 0-3.578-1.842-3.578H15.443c-.92 0-1.456-1.04-.92-1.788l9.696-13.